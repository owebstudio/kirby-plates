{
  "name": "owebstudio/kirby-plates",
  "description": "Plates native PHP template engine/system for Kirby.",
  "type": "kirby-plugin",
  "license": "MIT",
  "keywords": [
    "owebstudio",
    "owebstudio-plugin",
    "kirby",
    "kirby-3",
    "kirby3-plugin",
    "kirby-plugin",
    "kirby-template",
    "kirby-template-engine",
    "native-php-templates"
  ],
  "homepage": "https://owebstudio.com",
  "support": {
    "email": "support@owebstudio.com"
  },
  "authors": [
    {
      "name": "oweb studio",
      "email": "contact@owebstudio.com",
      "homepage": "https://owebstudio.com"
    }
  ],
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "getkirby/composer-installer": true
    }
  },
  "require": {
    "php": "^7.4|^8.0",
    "getkirby/composer-installer": "^1.2",
    "league/plates": "^3.0"
  },
  "conflict": {
    "getkirby/cms": ">=6.0"
  },
  "autoload": {
    "psr-4": {
      "Oweb\\": "src/"
    }
  },
  "extra": {
    "installer-name": "kirby-plates",
    "kirby": {
      "compatible": "^3.0 || ^4.0 || ^5.0"
    }
  }
}
