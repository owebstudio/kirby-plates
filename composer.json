{
  "name": "kirbynext/kirby-plates",
  "description": "Plates native PHP template engine/system for Kirby 3.",
  "type": "kirby-plugin",
  "version": "1.1.1",
  "license": "MIT",
  "keywords": [
    "kirby",
    "kirby-3",
    "kirbynext",
    "kirby3-plugin",
    "kirby-plugin",
    "kirbynext-plugin",
    "kirby-template",
    "kirby-template-engine",
    "native-php-templates"
  ],
  "authors": [
    {
      "name": "Kirby Next",
      "email": "support@kirbynext.com",
      "homepage": "https://kirbynext.com"
    }
  ],
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "getkirby/composer-installer": true
    }
  },
  "require": {
    "php": "^7.4|^8.0",
    "getkirby/composer-installer": "^1.2",
    "league/plates": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "KirbyNext\\": "src/"
    }
  },
  "extra": {
    "installer-name": "kirby-plates"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
